{
  "version": "0.2.0",
  "inputs": [
    {
      "id": "programArguments",
      "type": "promptString",
      "description": "Arguments to pass to the current file",
      "default": ""
    }
  ],
  "configurations": [
    {
      "name": ".NET Core Attach",
      "type": "coreclr",
      "request": "attach"
    },
    {
      "name": "Run: Go Current File",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${file}",
      "args": [
        "${input:programArguments}"
      ]
    },
    {
      "name": "Run: Python Current File",
      "type": "node-terminal",
      "request": "launch",
      "command": "python \"${file}\" ${input:programArguments}"
    },
    {
      "name": "Run: PowerShell Current File",
      "type": "node-terminal",
      "request": "launch",
      "command": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File \"${file}\" ${input:programArguments}"
    },
    {
      "name": "Debug: JavaScript Current File",
      "type": "node",
      "request": "launch",
      "program": "${file}",
      "cwd": "${fileDirname}",
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "Debug: JavaScript Current File with Arguments",
      "type": "node",
      "request": "launch",
      "program": "${file}",
      "args": "${input:programArguments}",
      "cwd": "${fileDirname}",
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "C/C++ Runner: Debug Session",
      "type": "cppdbg",
      "request": "launch",
      "args": [],
      "stopAtEntry": false,
      "externalConsole": true,
      "cwd": "c:/go1.27.4.linux-amd64 - Copy/go",
      "program": "c:/go1.27.4.linux-amd64 - Copy/go/build/Debug/outDebug",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}